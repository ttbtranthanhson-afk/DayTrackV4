{
  "manifest_version": 3,
  "name": "DayTrack Focus Shield",
  "version": "1.0.0",
  "description": "Đồng bộ Whitelist từ DayTrack và chặn các trang web nằm ngoài danh sách cho phép.",
  "permissions": ["tabs", "storage", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "DayTrack Focus Shield",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "102"
}
